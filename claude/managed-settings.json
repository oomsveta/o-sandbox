{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "WorktreeCreate": [
      { "hooks": [{ "type": "command", "command": "task hook-create" }] }
    ],
    "WorktreeRemove": [
      { "hooks": [{ "type": "command", "command": "task hook-remove" }] }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
