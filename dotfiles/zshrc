# Tab completion. Matching rules, each tried if the previous one found
# nothing: case-insensitive ("doc" -> "Documents"), then partial words
# ("f_b" -> "foo_bar"), then substring ("bar" -> "foobar").
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Offer to fix mistyped commands ("gti" -> "git"), but never into zsh's
# completion functions ("cowsay" -> "_cowsay").
setopt CORRECT
CORRECT_IGNORE='_*'

# A directory name alone cd's into it: ".." is "cd ..".
setopt AUTO_CD

# Prompt: dev@o-sandbox /odoo/enterprise(master) %
# Before each prompt (precmd), vcs_info puts the git branch in
# $vcs_info_msg_0_. PROMPT_SUBST expands it each time the prompt is drawn,
# hence the single quotes. %F{n}...%f: color n; %n: user; %m: hostname;
# %~: current directory; %#: "#" for root, "%" otherwise.
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '(%b)'
setopt PROMPT_SUBST
PROMPT='%F{33}%n%f@%F{28}%m%f %F{166}%~%f%F{125}${vcs_info_msg_0_}%f %# '

fortune | cowsay

# Warn, loudly, if the host's SSH agent (forwarded by VS Code) holds keys.
check-ssh-agent
