# Git relay: SSH server that the dev container's git talks to instead of
# GitHub. See relay.py.
FROM debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server \
        openssh-client \
        python3 \
        socat \
    && rm -rf /var/lib/apt/lists/* \
    # Host keys generated by the package: start.sh makes our own.
    && rm -f /etc/ssh/ssh_host_*

# The account the dev container logs in as. "*": no password, but not
# locked (sshd refuses locked accounts, even for public key logins).
RUN useradd --uid 2000 --create-home --shell /bin/sh git \
    && usermod -p '*' git

COPY sshd_config /etc/ssh/sshd_config
# GitHub's published SSH host keys (https://api.github.com/meta).
COPY github_known_hosts /etc/ssh/github_known_hosts
