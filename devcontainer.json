{
  "name": "Odoo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/odoo",
  "remoteUser": "dev",

  // VS Code forwards the host's SSH agent into the container no matter what
  // (/tmp/vscode-ssh-auth-*.sock). This only keeps tools from finding it: the
  // host's agent must stay empty (see "SSH" in the README), which
  // check-ssh-agent checks.
  "remoteEnv": {
    "SSH_AUTH_SOCK": ""
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "ms-python.debugpy",
        "ms-python.python",
        "Odoo.odoo",
        "Odoo.owl-vision"
      ],
      "settings": {
        "python.terminal.activateEnvironment": false,
        "ruff.lineLength": 100,
        "telemetry.telemetryLevel": "off",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "forwardPorts": [8069, 8072],

  "postCreateCommand": "seed-repos; pip install --upgrade pip wheel && pip install -r /odoo/community/requirements.txt",
  "postStartCommand": "link-skills",
  "postAttachCommand": "check-ssh-agent"
}
